# Current default setup (`doc_server` / `mcpdoc`)
# Only these variables are required for the canonical local start path.
PORT_DOC=8004

# Logging
LOG_LEVEL=INFO

# LLM API KEYS
TAVILY_API_KEY=

# Optional full-stack services (explicitly not part of the current default setup)
PORT_SCRAPER=8001
PORT_ANALYZER=8002
PORT_STORAGE=8003
PORT_PLAYWRIGHT=8005

# Optional database settings for `storage-server` / full-stack runs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_servers
POSTGRES_DB=mcp_servers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

